# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: use DATABASE_URL for Neon/PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Or configure PostgreSQL with individual values:
# DB_NAME=moment_ai
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# Optional: enables AI-generated reminder drafts (never commit a real key).
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
